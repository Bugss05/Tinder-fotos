# Configuração central. Todos os scripts fazem `source` deste ficheiro.
# Edita só isto; os scripts não precisam de mexer.

# ---------- Dados ----------
# Pasta com as tuas fotos originais (JPG/PNG direto da Canon, etc.)
DATASET_SRC="$HOME/fotos-lora"

# Palavra de ativação. Algo que não exista na língua, para o modelo não
# misturar com conceitos que já conhece.
TRIGGER="afnsx"
CLASS_WORD="man"

# Lado maior das imagens preparadas. A 1100D tira 4272x2848; não vale a
# pena guardar mais do que isto, o treino nunca usa tanta resolução.
PREP_MAX_SIDE=1536

# ---------- Treino ----------
# Resolução de treino (bucket base). 1024 dá melhor detalhe de cara;
# 768 é ~1.8x mais rápido e chega para um primeiro teste.
RESOLUTION=1024
NUM_REPEATS=1

NETWORK_DIM=16
NETWORK_ALPHA=16
LEARNING_RATE=1e-4
MAX_TRAIN_STEPS=2000
SAVE_EVERY_N_STEPS=250
SEED=42

# Blocos do DiT (32 no total) mantidos na RAM e enviados para a GPU à vez.
# Com fp8 o DiT ocupa ~7 GB; 0 pode caber nos 16 GB, mas começa com 8 e
# baixa se o nvtop/amdgpu_top mostrar folga.
BLOCKS_TO_SWAP=8

# Amostras durante o treino carregam também o text encoder (8B) e o VAE.
# Nos 16 GB isso é apertado, por isso fica desligado (0). Testa os
# checkpoints depois com scripts/07_generate.sh.
SAMPLE_EVERY_N_STEPS=0

# ---------- Modelos ----------
QWEN_IMAGE_REPO="Qwen/Qwen-Image-2.1"
CAPTION_MODEL_REPO="Qwen/Qwen3-VL-4B-Instruct"

# musubi-tuner: o suporte ao Qwen-Image 2.1 só existe no branch dev.
# Commit fixo = merge do PR #1145 (qwen-image-21), 12/10/2026.
MUSUBI_REPO="https://github.com/kohya-ss/musubi-tuner"
MUSUBI_BRANCH="dev"
MUSUBI_COMMIT="9702b25aa9b57b32020ce513ff79b7d2143ec664"

# ---------- PyTorch ROCm ----------
# Wheels oficiais da AMD para Radeon (ROCm 7.2.1, torch 2.9.1, Python 3.12).
ROCM_WHEEL_BASE="https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.1"
ROCM_WHEELS=(
  "torch-2.9.1%2Brocm7.2.1.lw.gitff65f5bc-cp312-cp312-linux_x86_64.whl"
  "torchvision-0.24.0%2Brocm7.2.1.gitb919bd0c-cp312-cp312-linux_x86_64.whl"
  "triton-3.5.1%2Brocm7.2.1.gita272dfa8-cp312-cp312-linux_x86_64.whl"
)

# ---------- Pastas internas (não precisas de mexer) ----------
DATA_DIR="data/train"
CACHE_DIR="data/cache"
OUTPUT_DIR="output"
OUTPUT_NAME="lora_${TRIGGER}"
